  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 閉店間際の古本屋",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "午後七時五十分、古本屋「みどり堂」の店内は、深い海の底のように静まっていた。天井の蛍光灯が一本だけ切れかけて、まばたきするように光っている。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "店主の久保田は帳場で、積み上がった文庫本の山を崩さないよう、そっと値札を貼っていた。背表紙の色褪せた本たちは、長い旅から戻った船乗りのように、どれも少し疲れた顔をしている。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "ドアのベルが鳴った。入ってきたのは、濡れた傘を提げた青年だった。肩に雨粒を光らせたまま、彼は棚と棚のあいだを、迷路でも歩くように進んでいく。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "「閉めるのは八時ですが、どうぞごゆっくり」",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "久保田が声をかけると、青年は小さくうなずいた。やがて彼は、一番奥の棚の前で足を止めた。そこには、背の剥げた詩集が一冊、古い鍵のように差し込まれていた。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "青年が本を開くと、紙の匂いがふわりと立った。乾いた草と、少し甘い埃の匂い。ページのあいだから、一枚の栞が落ちた。薄い桜色の紙で、誰かの細い字が書かれている。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "「あ」",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "青年の声は、水面に落ちた小石のようだった。拾い上げた栞を、彼はしばらく黙って見つめていた。",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "「それは、お客さんの前の持ち主さんのものでしょうね」と久保田が言った。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "「いえ」青年は首を振った。「これ、母の字です」",
      "no": 11
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "八時を告げる柱時計が、低く鳴った。久保田は帳場から立ち上がり、鍵束を手に取りかけて、やめた。壊れかけの蛍光灯が、またひとつまばたきをした。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "「閉めるのは、もう少しあとにしましょうか」",
      "no": 13
    },
    {
      "line": 27,
      "kind": "段落",
      "text": "雨音が、店じゅうの本に静かに降り積もっていた。",
      "no": 14
    }
  ]
}
