  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 閉校する小学校",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "三月の終わり、校庭の桜はまだ固い蕾のままであった。全校児童十一名の小さな学校は、この春を限りに、百四十年の歴史に幕を下ろす。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "教頭の田所は、最後の職員会議のあと、ひとり廊下を歩いた。床板は幾世代の上履きに磨かれて、鈍い飴色の艶を帯びている。教室の戸を開けると、黒板の隅に、卒業生たちの落書きが薄く残っていた。消しても消しても、白墨の痕は木目に沈んで、消えることがなかった。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "「先生、まだいたの」",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "振り向くと、六年生の健太が、ランドセルを背負って立っていた。もう下校の時刻はとうに過ぎている。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "「忘れ物か」\n「うん。あのね、校庭の隅に埋めたんだ。去年、タイムカプセル」",
      "no": 6
    },
    {
      "line": 14,
      "kind": "段落",
      "text": "二人は夕暮れの校庭へ出た。鉄棒は錆びて、ブランコの鎖が風にかすかに鳴った。健太は花壇の脇にしゃがみ、小さな缶を掘り出した。土の匂いが、冷たく立ちのぼった。",
      "no": 7
    },
    {
      "line": 16,
      "kind": "段落",
      "text": "「中、何が入ってるんだ」\n「十年後の自分への手紙。でも、この学校がなくなるなら、もう開けられない気がして」",
      "no": 8
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "田所は答えに窮した。やがて、ゆっくりと言った。",
      "no": 9
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "「学校はなくなっても、お前が覚えている限り、ここは在る。開けるのは、お前の好きなときでいい」",
      "no": 10
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "健太は黙って頷き、缶を胸に抱いた。西の空が茜から藍へ移ろうとしていた。田所は、誰もいない校舎の窓に、ひとつだけ灯りがともっているのを見た。それは、自分が消し忘れた職員室の灯であった。彼はそれを、そのままにしておくことにした。",
      "no": 11
    }
  ]
}
