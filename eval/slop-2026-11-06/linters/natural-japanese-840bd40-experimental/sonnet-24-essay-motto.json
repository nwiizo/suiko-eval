  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 朝の散歩で考えたこと",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "朝の散歩を始めて、三か月になる。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "きっかけは単純だった。健康診断の数値が少し悪く、医者に「歩きなさい」と言われた。それだけだ。最初の一週間は、三日で挫折した。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "それでも、四日目の朝に外へ出た。空気が澄んでいた。家の前の坂を下り、川沿いの道を歩く。三十分で戻れる、いつもの道だ。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "歩きはじめは、頭のなかがうるさい。仕事の段取り、返していないメール、昨日の失言。思考は、勝手に走る。けれど十五分も歩くと、不思議と静かになる。足が地面を踏む、そのリズムが、雑音を一つずつ消していくのだ。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "歩くと、考えがまとまる。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "これは本当だと思う。机の前で三時間悩んだ問題が、橋の上で急にほどけたことがあった。答えは、座って探すものではなく、歩いているときに向こうから来るものなのかもしれない。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "川には、毎朝同じ鷺がいる。動かない。ただ、水を見ている。その姿に、私はいつも少し恥ずかしくなる。あの鳥は、成果を急がない。待つことを、仕事にしている。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "続けることが、いちばん難しい。",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "雨の日は休んでもいい、と決めた。決めたら、かえって続くようになった。完璧を目指さないことが、継続のコツだった。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "先週、同じ道ですれ違う老夫婦と、挨拶を交わすようになった。名前は知らない。でも、いない朝は、少し気にかかる。小さな関係が、一日の最初に積み重なっていく。",
      "no": 11
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "散歩は、贅沢でも修行でもない。ただの習慣だ。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "けれど、その習慣のなかで、自分が何を考えているのか、ようやく聞こえてくる。急がなくていい。立ち止まってもいい。",
      "no": 13
    },
    {
      "line": 27,
      "kind": "段落",
      "text": "明日も、歩こう。",
      "no": 14
    }
  ]
}
