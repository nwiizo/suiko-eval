  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 顧客対応の基本方針",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "当社の顧客対応における基本方針を定める。すべての社員は、以下に従って行動する。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "第一に、顧客の話を最後まで聞く。途中で遮らず、要点を確認してから回答する。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "第二に、事実を正確に伝える。わからないことは、わからないと答え、確認したうえで、期限を示して回答する。推測で答えてはならない。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "第三に、約束は守る。守れない約束はしない。やむを得ず遅れる場合は、期限の前に、自分から連絡する。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "第四に、問い合わせには、原則として一営業日以内に最初の返信をする。解決に時間がかかる場合でも、受け付けたことと、次の連絡の時期を伝える。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "第五に、誤りがあれば、速やかに認めて謝罪する。責任の所在の議論より、顧客への影響の解消を優先する。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "第六に、個人情報と機密情報を守る。顧客から預かった情報は、業務に必要な範囲でのみ扱い、許可なく社外に出してはならない。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "第七に、対応の記録を残す。誰が、いつ、何を伝えたのかを、共有の管理表に記録する。担当者が替わっても、顧客に同じ説明を求めない。",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "第八に、判断に迷う場合は、一人で決めない。上長に相談し、必要であれば、関係部門に引き継ぐ。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "第九に、顧客の声を改善に生かす。繰り返し寄せられる要望や不満は、月次の会議で共有し、製品とサービスの見直しに反映する。",
      "no": 11
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "第十に、言葉づかいは丁寧にし、相手の立場に敬意を払う。厳しい指摘を受けた場合も、感情的に反応してはならない。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "本方針は、年に一度見直す。改定の際は、全社員に周知する。",
      "no": 13
    }
  ]
}
