  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 終電を逃した夜",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "改札の向こうで、シャッターが下りる音がした。鈍い金属の響きが、無人になったコンコースに長く尾を引いた。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "由紀は腕時計を見た。零時四十二分。終電は、三分前に出ていた。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "駅前の広場には、街灯の光が白く沈んでいた。ベンチには誰もいない。タクシー乗り場にも、車の影はなかった。彼女は鞄を抱え直し、冷えた空気を胸の奥まで吸い込んだ。吐いた息が、ほのかに白かった。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "歩いて帰れない距離ではない。けれど、そうする気にもなれなかった。今夜の会議で、彼女は長年の同僚と意見を違えた。言い過ぎたかもしれないという思いが、帰り道のあいだじゅう、棘のように胸に刺さっていた。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "ふと、広場の隅に、灯りのともった自動販売機が見えた。夜のなかで、そこだけが小さな港のように明るい。彼女は近づき、硬貨を落として、温かい缶のお茶を買った。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "缶を両手で包むと、じんわりと熱が伝わった。そのとき、遠くで犬の鳴く声がした。それに応えるように、どこかの窓で、カーテンの揺れる気配がした。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "世界は眠っているのではない、と由紀は思った。ただ、私を待たずに、静かに続いているだけなのだ。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "彼女はお茶を飲み干し、空き缶をゴミ箱に落とした。乾いた音が、夜気に溶けた。",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "携帯電話を取り出し、同僚の名前を画面に出す。指が少しためらい、それから、短い言葉を打った。「さっきは、ごめん」",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "送信を押すと、彼女は歩き出した。街灯の列が、帰り道を細く照らしていた。",
      "no": 11
    }
  ]
}
