  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 朝の散歩で考えたこと",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "朝は、靴ひもを結ぶところから始まる。  \n一歩目で、昨日の続きがほどける。",
      "no": 2
    },
    {
      "line": 6,
      "kind": "段落",
      "text": "道は急がない。  \n曲がり角まで歩けば、景色が変わる。",
      "no": 3
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "街路樹は黙って立つ。  \nそれでも季節のことを教えてくれる。",
      "no": 4
    },
    {
      "line": 12,
      "kind": "段落",
      "text": "考えは、歩幅に合わせて整う。  \n答えを追い立てない。",
      "no": 5
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "信号で止まる。  \n止まる時間も、散歩の一部だ。",
      "no": 6
    },
    {
      "line": 18,
      "kind": "段落",
      "text": "遠くの犬が吠える。  \n知らない朝にも、暮らしはある。",
      "no": 7
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "昨日の失敗は、靴底の小石に似ている。  \n気づけば、立ち止まって取り除ける。",
      "no": 8
    },
    {
      "line": 24,
      "kind": "段落",
      "text": "大きな決断をしなくていい。  \n小さな方向を選べばいい。",
      "no": 9
    },
    {
      "line": 27,
      "kind": "段落",
      "text": "橋の上で、川を見る。  \n流れは同じ場所にとどまらない。",
      "no": 10
    },
    {
      "line": 30,
      "kind": "段落",
      "text": "私も、昨日と同じではない。  \n変化は、声を張らずに訪れる。",
      "no": 11
    },
    {
      "line": 33,
      "kind": "段落",
      "text": "家へ戻る。  \n机の上には、まだ手つかずの仕事がある。",
      "no": 12
    },
    {
      "line": 36,
      "kind": "段落",
      "text": "歩いた距離は短い。  \n気持ちには、窓が一つ増えた。",
      "no": 13
    },
    {
      "line": 39,
      "kind": "段落",
      "text": "朝の散歩は、答えをくれない。  \n問いを持てる余白をくれる。",
      "no": 14
    },
    {
      "line": 42,
      "kind": "段落",
      "text": "だから明日も、靴を履く。  \n一歩目から、考え直せる。",
      "no": 15
    }
  ]
}
