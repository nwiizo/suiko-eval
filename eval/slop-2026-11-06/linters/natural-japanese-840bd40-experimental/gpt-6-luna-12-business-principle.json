  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 顧客対応の基本方針",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "私たちは、顧客の状況を正確に理解し、約束できることを明確に伝え、解決まで責任を持って対応する。顧客対応では、次の原則を守る。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "見出し",
      "text": "## まず話を聞く",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "顧客の説明を遮らず、困っていることと期待する結果を確認する。要望の背景、発生した時期、影響を受けている業務を質問する。理解した内容を自分の言葉で要約し、認識が合っているか確かめる。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "見出し",
      "text": "## 事実を確かめてから答える",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "確認できていない情報を断定しない。調査が必要な場合は、その旨と次の連絡時刻を伝える。回答を急ぐあまり、根拠のない見通しや確約を示さない。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "見出し",
      "text": "## 期限と担当を明らかにする",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "問い合わせを受けた担当者は、次の対応者と期限を記録する。別の部署へ引き継ぐときは、顧客に同じ説明を繰り返させない。引き継ぎ先、共有した情報、次回連絡の予定を伝える。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "見出し",
      "text": "## できることを具体的に説明する",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "対応範囲や制約がある場合は、理由と選択肢を分かりやすく説明する。実施できないことを曖昧に約束しない。代替策を案内する場合は、費用、時間、影響を確認できる範囲で添える。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "見出し",
      "text": "## 解決を確認して記録する",
      "no": 11
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "こちらの作業が終わった時点だけで対応を閉じない。顧客の困りごとが解消したかを確認する。経緯、判断、残る課題を記録し、同じ問題の再発防止や次の担当者に活用する。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "丁寧さは、敬語の多さではなく、相手の状況を踏まえた正確な対応に表れる。すべての窓口でこの原則を共有し、問い合わせの内容に応じて必要な担当者が協力する。",
      "no": 13
    }
  ]
}
