      "snippet": "\u5909\u5316\u306f\u3001\u3068\u304d\u306b\u5fc3\u3092\u843d\u3061\u7740\u304b\u306a\u304f\u3055\u305b\u308b\u3002\u3051\u308c\u3069\u5b63\u7bc0\u306e\u63fa\u3089\u304e\u306f\u3001\u540c\u3058\u65e5\u304c\u6c38\u9060\u306b\u306f\u7d9a\u304b\u306a\u3044\u3053\u3068\u3092\u7a4f\u3084\u304b\u306b\u6559\u3048\u308b\u3002\u7d42\u308f\u308a\u304c\u6b21\u306e\u59cb\u307e\u308a\u3078\u5834\u6240\u3092\u8b72\u308a\u3001\u51b7\u305f\u3044\u98a8\u304c\u65b0\u3057\u3044\u6642\u9593\u3092\u904b\u3076\u3002\u5b63\u7bc0\u306e\u5909\u308f\u308a\u76ee\u306f\u3001\u66ae\u3089\u3057\u306e\u9801\u3092\u3081\u304f\u308b\u898b\u3048\u306a\u3044\u6307\u3067\u3042\u308b\u3002"
    }
