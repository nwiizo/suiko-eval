    {
      "line": 1,
      "kind": "見出し",
      "text": "# 新規事業チームの行動指針",
      "no": 1
    },
    {
      "line": 3,
      "kind": "見出し",
      "text": "## 顧客の現実から始める",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "顧客の声を聞く。  \n現場を観察する。  \n思い込みを事実で確かめる。",
      "no": 3
    },
    {
      "line": 9,
      "kind": "見出し",
      "text": "## 問いを絞る",
      "no": 4
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "解く課題を一つに定める。  \n目的と手段を混同しない。  \n成果の定義を先に決める。",
      "no": 5
    },
    {
      "line": 15,
      "kind": "見出し",
      "text": "## 小さく試す",
      "no": 6
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "最小の検証を早く行う。  \n結果が出るまで待ち続けない。  \n学びを次の判断に使う。",
      "no": 7
    },
    {
      "line": 21,
      "kind": "見出し",
      "text": "## 数字を共有する",
      "no": 8
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "事実と解釈を分ける。  \n都合のよい指標を選ばない。  \n不確実さを明らかにする。",
      "no": 9
    },
    {
      "line": 27,
      "kind": "見出し",
      "text": "## 決定を記録する",
      "no": 10
    },
    {
      "line": 29,
      "kind": "段落",
      "text": "決めた理由を残す。  \n担当と期限を明確にする。  \n状況が変われば見直す。",
      "no": 11
    },
    {
      "line": 33,
      "kind": "見出し",
      "text": "## 失敗から学ぶ",
      "no": 12
    },
    {
      "line": 35,
      "kind": "段落",
      "text": "失敗を隠さない。  \n責任追及より原因の理解を優先する。  \n同じ失敗を仕組みで防ぐ。",
      "no": 13
    },
    {
      "line": 39,
      "kind": "見出し",
      "text": "## 速さと信頼を両立する",
      "no": 14
    },
    {
      "line": 41,
      "kind": "段落",
      "text": "約束を守る。  \n難しいときは早く伝える。  \n品質と安全の基準を守る。",
      "no": 15
    },
    {
      "line": 45,
      "kind": "見出し",
      "text": "## チームで成果をつくる",
      "no": 16
    },
    {
      "line": 47,
      "kind": "段落",
      "text": "知見を開く。  \n異論を歓迎する。  \n成果を関係者と分かち合う。",
      "no": 17
    },
    {
      "line": 51,
      "kind": "見出し",
      "text": "## 手を止めて確かめる",
      "no": 18
    },
    {
      "line": 53,
      "kind": "段落",
      "text": "続ける根拠を定期的に点検する。  \n価値が薄れた取り組みを終える。  \n学びを次の挑戦へ渡す。",
      "no": 19
    }
  ]
