    {
      "line": 1,
      "kind": "見出し",
      "text": "# つくる人と、働こう。",
      "no": 1
    },
    {
      "line": 3,
      "kind": "見出し",
      "text": "## 問いから始める。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "答えを急がない。前提を疑う。目的を確かめる。良い問いが、良いプロダクトをつくる。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "見出し",
      "text": "## 小さく出す。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "完璧を待たない。動くものを届ける。反応を受け取る。学びを次へつなぐ。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "見出し",
      "text": "## 深く掘る。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "表面で終わらない。症状と原因を分ける。仕組みを理解する。直すなら、根まで届かせる。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "見出し",
      "text": "## 利用者を見る。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "コードだけを見ない。その先の人を見る。迷いを減らす。時間を返す。技術を価値に変える。",
      "no": 9
    },
    {
      "line": 19,
      "kind": "見出し",
      "text": "## 言葉にする。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "考えを開く。判断を残す。知らないと言う。助けを求める。明快な言葉が、チームを速くする。",
      "no": 11
    },
    {
      "line": 23,
      "kind": "見出し",
      "text": "## 違いを歓迎する。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "同じ経験を求めない。異なる視点を招く。反対意見を聞く。強い結論を、対話でつくる。",
      "no": 13
    },
    {
      "line": 27,
      "kind": "見出し",
      "text": "## 品質を守る。",
      "no": 14
    },
    {
      "line": 29,
      "kind": "段落",
      "text": "速さだけを誇らない。テストを書く。運用を考える。壊れ方を想像する。信頼を積み上げる。",
      "no": 15
    },
    {
      "line": 31,
      "kind": "見出し",
      "text": "## 手を動かす。",
      "no": 16
    },
    {
      "line": 33,
      "kind": "段落",
      "text": "肩書きに隠れない。必要な仕事を拾う。試す。確かめる。前進を自分から生み出す。",
      "no": 17
    },
    {
      "line": 35,
      "kind": "見出し",
      "text": "## 学びを渡す。",
      "no": 18
    },
    {
      "line": 37,
      "kind": "段落",
      "text": "知識を囲わない。失敗を共有する。仕組みに残す。昨日の発見を、明日の標準にする。",
      "no": 19
    },
    {
      "line": 39,
      "kind": "見出し",
      "text": "## 誠実に選ぶ。",
      "no": 20
    },
    {
      "line": 41,
      "kind": "段落",
      "text": "都合の悪い事実を隠さない。近道の代償を語る。できない約束をしない。信頼を判断の中心に置く。",
      "no": 21
    },
    {
      "line": 43,
      "kind": "見出し",
      "text": "## 仕事を楽しむ。",
      "no": 22
    },
    {
      "line": 45,
      "kind": "段落",
      "text": "難問を面白がる。仲間の成果を喜ぶ。好奇心を手放さない。良い仕事に、熱を宿す。",
      "no": 23
    },
    {
      "line": 47,
      "kind": "見出し",
      "text": "## 一緒につくる。",
      "no": 24
    },
    {
      "line": 49,
      "kind": "段落",
