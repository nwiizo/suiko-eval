  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 引っ越して最初の一週間",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "引っ越しの日は雨だった。段ボールを運び込むころには、床がうっすら濡れた足跡で埋まっていた。業者が帰ったあと、部屋には箱の山と私だけが残った。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "最初の三日間は、まともに料理をしなかった。鍋がどの箱に入っているのかわからなかったからだ。コンビニで買ったおにぎりを、箱の上に皿を置いて食べた。四日目にようやく鍋が見つかり、インスタントの味噌汁を作った。お湯を沸かしただけなのに、少し安心した。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "意外だったのは、音の違いだった。前の部屋では電車の音が聞こえていたが、ここでは聞こえない。代わりに、朝になると上の階から椅子を引く音がする。最初は気になったけれど、三日ほどで目覚ましの代わりになった。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "近所を歩くのも、この一週間で覚えたことだ。駅までの道を、わざと違うルートで三回歩いた。二回目に小さなパン屋を見つけ、三回目には、そこの閉店時間が思ったより早いことを知った。夕方に行くと、棚はほとんど空になっている。次の日は朝に寄って、クリームパンを買った。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "郵便受けには、前の住人宛ての封筒が二通入っていた。どうしたらいいかわからず、管理会社に電話をかけた。担当の人は「そのまま置いておいてください」と言った。拍子抜けしたが、そういうものらしい。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "七日目の夜、最後の段ボールを開けた。中身は本と、使っていない延長コードだった。本を棚に並べ終えると、部屋が急に自分のものに見えてきた。まだ家具の位置はしっくりこない。それでも、窓の外の街灯がどこに映るのかは、もう知っている。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "慣れるというのは、特別なことが起きるわけではなく、知っていることが少しずつ増えていくことなのだと思う。",
      "no": 8
    }
  ]
}
