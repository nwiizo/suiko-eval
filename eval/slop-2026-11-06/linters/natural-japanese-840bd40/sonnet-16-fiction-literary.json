  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 港町の喫茶店",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "坂を下りきったところに、その喫茶店はあった。潮風に晒された木の看板には、かろうじて「汀」の一字が読める。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "水野澄子は、十年ぶりにその扉を押した。鈴が鳴った。記憶のなかの音よりも、少し濁っていた。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "店内は薄暗く、煙草と珈琲の古い匂いが壁に染みついていた。カウンターの向こうで、白髪の主人が豆を挽いていた。顔を上げた彼は、澄子を見て、ほんのわずか目を細めた。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "「窓際、空いてますよ」",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "それだけだった。十年のあいだに何があったのか、彼は尋ねなかった。澄子はありがたいと思い、同時に少しだけ寂しいとも思った。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "窓の外には、錆びたクレーンと、停泊した漁船が見えた。曇天の下で、海は鈍い鉛の色をしている。ここで、彼女はかつて一人の男を待っていた。船乗りだった。出航の朝に「帰ったらここで会おう」と言い残し、それきり便りは途絶えた。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "珈琲が運ばれてきた。白い厚手のカップから、細い湯気が立ちのぼる。一口含むと、苦みの奥に、ひどく懐かしい甘さがあった。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "「あの人のこと、聞きましたか」",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "澄子がようやく口にすると、主人は布巾を持つ手を止めた。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "「去年、亡くなったそうです。遠い港で」",
      "no": 11
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "彼はそう言い、しばらく黙っていた。それから、棚の奥から色褪せた封筒を取り出した。宛名は、澄子の名前だった。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "「預かっていたんです。いつか、来る気がして」",
      "no": 13
    },
    {
      "line": 27,
      "kind": "段落",
      "text": "澄子は封筒を受け取った。開けずに、膝の上に置いた。窓の外では、日が傾き、鉛色の海がかすかに金を帯びはじめていた。",
      "no": 14
    },
    {
      "line": 29,
      "kind": "段落",
      "text": "珈琲は、冷めかけていた。それでも彼女は、最後の一滴まで、ゆっくりと飲み干した。",
      "no": 15
    }
  ]
}
