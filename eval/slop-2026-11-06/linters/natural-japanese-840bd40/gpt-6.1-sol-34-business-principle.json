  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 情報を守る行動原則",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "情報の利用目的を明確にする。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "業務に必要な範囲だけを取得する。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "取得時に情報の管理区分を確認する。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "保存先は会社が認めた場所を使う。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "個人のアカウントへ業務情報を移さない。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "共有範囲は必要な相手に絞る。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "公開リンクの発行前に閲覧範囲を確かめる。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "宛先と添付ファイルは送信前に確認する。",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "機密情報の送信には指定の方法を使う。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "認証情報は他人と共有しない。",
      "no": 11
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "パスワードはサービスごとに異なるものを使う。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "パスワードの管理には承認済みの管理ツールを使う。",
      "no": 13
    },
    {
      "line": 27,
      "kind": "段落",
      "text": "多要素認証は利用可能な業務サービスで有効にする。",
      "no": 14
    },
    {
      "line": 29,
      "kind": "段落",
      "text": "心当たりのない認証要求は拒否して報告する。",
      "no": 15
    },
    {
      "line": 31,
      "kind": "段落",
      "text": "権限は業務に必要な最小限にする。",
      "no": 16
    },
    {
      "line": 33,
      "kind": "段落",
      "text": "異動と退職に伴う権限変更を速やかに行う。",
      "no": 17
    },
    {
      "line": 35,
      "kind": "段落",
      "text": "端末を離れるときは画面をロックする。",
      "no": 18
    },
    {
      "line": 37,
      "kind": "段落",
      "text": "更新プログラムは社内の適用方針に従って導入する。",
      "no": 19
    },
    {
      "line": 39,
      "kind": "段落",
      "text": "外部媒体は承認されたものだけを接続する。",
      "no": 20
    },
    {
      "line": 41,
      "kind": "段落",
      "text": "外出先では画面と会話からの漏えいを防ぐ。",
      "no": 21
    },
    {
      "line": 43,
      "kind": "段落",
      "text": "送信者の名前だけで依頼を信用しない。",
      "no": 22
    },
    {
      "line": 45,
      "kind": "段落",
      "text": "不審なリンクと添付ファイルは開かない。",
      "no": 23
    },
    {
      "line": 47,
      "kind": "段落",
      "text": "送金や権限変更の依頼は別の連絡経路で確かめる。",
      "no": 24
    },
    {
      "line": 49,
      "kind": "段落",
      "text": "外部サービスへの情報入力は利用条件と社内規定に従う。",
      "no": 25
    },
    {
      "line": 51,
      "kind": "段落",
      "text": "生成AIへの入力にも情報の管理区分を適用する。",
      "no": 26
    },
    {
      "line": 53,
      "kind": "段落",
      "text": "委託先との共有には契約と許可された範囲を守る。",
      "no": 27
    },
    {
      "line": 55,
      "kind": "段落",
      "text": "本番相当のデータを検証環境へ移す前に利用条件を確認する。",
      "no": 28
    },
    {
      "line": 57,
      "kind": "段落",
      "text": "検証には目的に足りる最小限のデータを使う。",
      "no": 29
    },
    {
      "line": 59,
      "kind": "段落",
      "text": "不要になった情報は保存期間と廃棄手順に従って削除する。",
      "no": 30
    },
    {
      "line": 61,
      "kind": "段落",
      "text": "紙の機密資料は指定の方法で廃棄する。",
      "no": 31
    },
    {
      "line": 63,
      "kind": "段落",
      "text": "紛失と誤送信は判明した時点で報告する。",
      "no": 32
    },
    {
      "line": 65,
      "kind": "段落",
      "text": "不審な動作は指定の窓口へ速やかに伝える。",
      "no": 33
    },
    {
      "line": 67,
      "kind": "段落",
      "text": "事故の報告に自己判断の原因確定を待たせない。",
      "no": 34
    },
    {
      "line": 69,
      "kind": "段落",
      "text": "証拠になり得る記録を独断で消さない。",
      "no": 35
    },
    {
      "line": 71,
      "kind": "段落",
      "text": "事故対応は担当部署の指示に従う。",
      "no": 36
    },
    {
      "line": 73,
      "kind": "段落",
      "text": "例外の利用には期限と承認の記録を残す。",
      "no": 37
    },
    {
      "line": 75,
      "kind": "段落",
      "text": "迷った判断は実行前に担当窓口へ確認する。",
      "no": 38
    }
  ]
}
