  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# コードレビューの心得",
      "no": 1
    },
    {
      "line": 3,
      "kind": "段落",
      "text": "コードレビューは、変更を安全に届け、チームの理解を揃えるために行う。次の原則を守る。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "見出し",
      "text": "## 変更の目的を確認する",
      "no": 3
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "差分を読む前に、何を解決する変更かを把握する。目的が不明なら、実装の好みを議論する前に背景を確認する。要求された振る舞いと変更内容が対応しているかを確かめる。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "見出し",
      "text": "## 重要なリスクから見る",
      "no": 5
    },
    {
      "line": 11,
      "kind": "段落",
      "text": "データ消失、権限の過剰付与、互換性の破壊、失敗時の復旧困難を優先して確認する。命名や整形の指摘で重大な問題を埋もれさせない。影響範囲と発生条件を示し、修正の必要性を説明する。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "見出し",
      "text": "## 事実と好みを分ける",
      "no": 7
    },
    {
      "line": 15,
      "kind": "段落",
      "text": "不具合、仕様との不一致、保守上のリスクを具体的に示す。単なる好みは必須の修正として扱わない。代案を提案する場合は、読みやすさや安全性がどう改善するかを述べる。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "見出し",
      "text": "## 差分の範囲を尊重する",
      "no": 9
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "レビューでは、依頼された変更に関係する箇所を中心に見る。周辺の改善案は別の作業として提案する。指摘を増やすために変更範囲を広げない。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "見出し",
      "text": "## 質問は明確に書く",
      "no": 11
    },
    {
      "line": 23,
      "kind": "段落",
      "text": "前提が読み取れない場合は、断定ではなく質問にする。どの行のどの振る舞いについて、何を確認したいのかを示す。書き手が意図を説明できる余地を残す。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "見出し",
      "text": "## 修正後も目的を検証する",
      "no": 13
    },
    {
      "line": 27,
      "kind": "段落",
      "text": "修正された指摘は、差分と必要な確認方法を見て解消を判断する。コードが変わっただけで完了としない。レビューの目的は、指摘を数えることではなく、変更を安心して届けられる状態にすることだ。",
      "no": 14
    }
  ]
}
