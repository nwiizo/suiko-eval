  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 一緒に働きたいデザイナー",
      "no": 1
    },
    {
      "line": 3,
      "kind": "見出し",
      "text": "## 問いを、形にする。",
      "no": 2
    },
    {
      "line": 4,
      "kind": "段落",
      "text": "見た目を整える前に、何を解くべきかを考える。依頼の奥にある困りごとを見つける。答えを急がず、問いを磨く。",
      "no": 3
    },
    {
      "line": 6,
      "kind": "見出し",
      "text": "## 使う人から始める。",
      "no": 4
    },
    {
      "line": 7,
      "kind": "段落",
      "text": "自分の好みだけで決めない。使う人の声を聞く。迷う場所を観察する。小さな不便を見逃さない。",
      "no": 5
    },
    {
      "line": 9,
      "kind": "見出し",
      "text": "## つくって、確かめる。",
      "no": 6
    },
    {
      "line": 10,
      "kind": "段落",
      "text": "最初の案に固執しない。試作品を早く見せる。反応から学び、次の案へ進む。完成は、検証の先にある。",
      "no": 7
    },
    {
      "line": 12,
      "kind": "見出し",
      "text": "## 違いを、チームの力にする。",
      "no": 8
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "デザイナーだけで抱え込まない。エンジニアと一緒に考える。企画や営業の知恵を借りる。異なる視点を、よい体験へ束ねる。",
      "no": 9
    },
    {
      "line": 15,
      "kind": "見出し",
      "text": "## 理由を言葉にする。",
      "no": 10
    },
    {
      "line": 16,
      "kind": "段落",
      "text": "色にも、余白にも、選んだ理由を持つ。感覚を共有できる言葉に変える。議論を怖がらず、よりよい判断を探す。",
      "no": 11
    },
    {
      "line": 18,
      "kind": "見出し",
      "text": "## 手を動かし続ける。",
      "no": 12
    },
    {
      "line": 19,
      "kind": "段落",
      "text": "新しい道具を試す。基礎を磨く。知らない領域に踏み出す。学びを、明日の仕事へつなげる。",
      "no": 13
    },
    {
      "line": 21,
      "kind": "見出し",
      "text": "## 仕上げまで見届ける。",
      "no": 14
    },
    {
      "line": 22,
      "kind": "段落",
      "text": "細部に責任を持つ。実装の現場を知る。公開後の声を聞く。届けた先で役に立つまで、デザインを続ける。",
      "no": 15
    },
    {
      "line": 24,
      "kind": "見出し",
      "text": "## 誠実につくる。",
      "no": 16
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "できることを正直に伝える。アクセシビリティを後回しにしない。誰かを置き去りにしない選択を重ねる。",
      "no": 17
    },
    {
      "line": 27,
      "kind": "見出し",
      "text": "## 一緒に、よくする。",
      "no": 18
    },
    {
      "line": 28,
      "kind": "段落",
      "text": "完璧な人より、学び合える人。正解を知る人より、問いを持ち寄れる人。昨日のやり方を見直し、チームとともに前へ進める人。",
      "no": 19
    }
  ]
}
