  "paragraphs": [
    {
      "line": 1,
      "kind": "見出し",
      "text": "# 私たちが一緒に働きたい人",
      "no": 1
    },
    {
      "line": 3,
      "kind": "見出し",
      "text": "## 問いから始める人。",
      "no": 2
    },
    {
      "line": 5,
      "kind": "段落",
      "text": "「なぜ？」を飲み込まない。仕様の裏にある目的を、自分の手で確かめにいく。",
      "no": 3
    },
    {
      "line": 7,
      "kind": "見出し",
      "text": "## 手を動かして考える人。",
      "no": 4
    },
    {
      "line": 9,
      "kind": "段落",
      "text": "議論は短く。試作は早く。動くものが、いちばん雄弁だ。",
      "no": 5
    },
    {
      "line": 11,
      "kind": "見出し",
      "text": "## 失敗を隠さない人。",
      "no": 6
    },
    {
      "line": 13,
      "kind": "段落",
      "text": "障害は共有する。振り返りは責めない。学びは全員のものにする。",
      "no": 7
    },
    {
      "line": 15,
      "kind": "見出し",
      "text": "## 読みやすさを書く人。",
      "no": 8
    },
    {
      "line": 17,
      "kind": "段落",
      "text": "コードは読まれるために書く。ドキュメントは未来の仲間への手紙。",
      "no": 9
    },
    {
      "line": 19,
      "kind": "見出し",
      "text": "## 人に聞ける人。",
      "no": 10
    },
    {
      "line": 21,
      "kind": "段落",
      "text": "詰まったら、一時間で声を上げる。助けを求めるのは、実力のうち。",
      "no": 11
    },
    {
      "line": 23,
      "kind": "見出し",
      "text": "## 人を助けられる人。",
      "no": 12
    },
    {
      "line": 25,
      "kind": "段落",
      "text": "レビューは丁寧に。知っていることは惜しまず渡す。",
      "no": 13
    },
    {
      "line": 27,
      "kind": "見出し",
      "text": "## 変化を面白がる人。",
      "no": 14
    },
    {
      "line": 29,
      "kind": "段落",
      "text": "新しい技術に飛びつく。でも、使う理由は説明できる。",
      "no": 15
    },
    {
      "line": 31,
      "kind": "見出し",
      "text": "## 使う人を思い浮かべられる人。",
      "no": 16
    },
    {
      "line": 33,
      "kind": "段落",
      "text": "画面の向こうにいる、一人の顔を想像する。機能より、困りごとを見る。",
      "no": 17
    },
    {
      "line": 35,
      "kind": "見出し",
      "text": "## 技術で終わらない人。",
      "no": 18
    },
    {
      "line": 37,
      "kind": "段落",
      "text": "正しい設計より、届く設計。事業の言葉でも話せるエンジニアでいる。",
      "no": 19
    },
    {
      "line": 39,
      "kind": "見出し",
      "text": "## こんな環境で、働いてほしい。",
      "no": 20
    },
    {
      "line": 41,
      "kind": "箇条書き",
      "text": "- リモートと出社は、自分で選ぶ。",
      "no": 21
    },
    {
      "line": 42,
      "kind": "箇条書き",
      "text": "- 学習の時間と予算は、会社が持つ。",
      "no": 22
    },
    {
      "line": 43,
      "kind": "箇条書き",
      "text": "- 小さく出して、早く直す。",
      "no": 23
    },
    {
      "line": 44,
      "kind": "箇条書き",
      "text": "- 肩書きより、提案を見る。",
      "no": 24
    },
    {
      "line": 46,
      "kind": "見出し",
      "text": "## 経験は問わない。",
      "no": 25
    },
    {
      "line": 48,
      "kind": "段落",
      "text": "言語も、年数も、肩書きも、最初は問わない。見たいのは、これから何を作りたいか。",
      "no": 26
    },
    {
      "line": 50,
      "kind": "見出し",
      "text": "## 一緒に、いいものを作ろう。",
      "no": 27
    },
    {
      "line": 52,
      "kind": "段落",
      "text": "まずはカジュアル面談から。気軽に話しにきてください。",
      "no": 28
    }
  ]
}
